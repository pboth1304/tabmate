{
  "name": "@tabmate/vue",
  "version": "0.1.1",
  "main": "dist/index.js",
  "module": "dist/index.esm.js",
  "types": "dist/index.d.ts",
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc --noEmit && vite build",
    "test": "vitest"
  },
  "author": {
    "name": "Pascal Bothner",
    "email": "pascalcodes@pm.me"
  },
  "private": false,
  "description": "TabMate is a lightweight (~<1KB gzipped), framework-agnostic JavaScript library for enabling tab/indentation behavior to HTML elements like `textarea` — just like in modern code editors. This package adds support for easier integration with Vue.",
  "keywords": [
    "textarea",
    "indentation",
    "tab",
    "editor",
    "code-editor",
    "shift-tab",
    "tab-key",
    "text-editor",
    "form",
    "web-editor",
    "indent",
    "dedent",
    "typescript",
    "multiline",
    "text-input",
    "input-enhancement",
    "vue"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/user/tabmate.git",
    "directory": "packages/vue"
  },
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.esm.js",
      "require": "./dist/index.js"
    }
  },
  "dependencies": {
    "@tabmate/core": ">=0.2.0"
  },
  "peerDependencies": {
    "vue": ">=3.0.0"
  },
  "devDependencies": {
    "vue": "^3.5.22"
  }
}
